# VMware memory tiering report - standalone container configuration
# Copy to .env (docker compose) and keep it private: it contains passwords.

# --- vCenter (required) -----------------------------------------------------
# One or more vCenter FQDNs, comma separated
MEMTIER_SERVERS=vcenter01.example.com
# A read-only SSO account is enough (the built-in Read-only role)
MEMTIER_USERNAME=svc-memtier@vsphere.local
MEMTIER_PASSWORD=
# Or read the password from a file (Docker secret), e.g. /run/secrets/memtier_password
# MEMTIER_PASSWORD_FILE=

# TLS: keep verification on and mount the vCenter root CA ("Download trusted
# root CA certificates" on the vCenter start page), or set false for a lab.
MEMTIER_VERIFY_TLS=true
# MEMTIER_CA_FILE=/certs/vcenter-ca.pem

# --- web interface ----------------------------------------------------------
# Strongly recommended when the port is reachable from your network: the report
# lists every host and VM. Empty = no authentication.
MEMTIER_UI_USERNAME=admin
MEMTIER_UI_PASSWORD=
# MEMTIER_PORT=8080

# --- report -----------------------------------------------------------------
# MEMTIER_REPORT_DAYS=30
# THE decision metric: a cluster is a tiering candidate when active memory stays
# at or below this % of consumed memory - the rest is cold and moves to NVMe.
# MEMTIER_CANDIDATE_PCT=40
# Feasibility: the hot working set has to stay in DRAM (Broadcom's 1:1 guidance).
# MEMTIER_THRESHOLD_PCT=50
# NVMe tier size per unit of DRAM used for the sizing table (1.0 = the 1:1 maximum)
# MEMTIER_TIER_RATIO=1.0
# Stretched clusters: true for all, or list them by name (comma separated)
# MEMTIER_STRETCHED_CLUSTER=false
# MEMTIER_STRETCHED_CLUSTERS=Metro-A,Metro-B
# MEMTIER_COLD_PCT=40
# MEMTIER_HOT_PCT=75
# MEMTIER_TITLE=VMware Memory Tiering Report
# MEMTIER_SUPPORT_CONTACT=https://github.com/steiner-dominik/vmware-memory-report/issues

# --- collector --------------------------------------------------------------
# How often to collect: 60, 30 or 15. Every run reads all 20-second samples of its
# window, so a shorter interval does not find peaks an hourly run misses - it gives
# a finer time resolution and loses less data when a single run fails.
# MEMTIER_INTERVAL_MINUTES=60
# MEMTIER_EXCLUDE_VM_PATTERN=^vCLS-
# MEMTIER_RETENTION_MONTHS=13
# MEMTIER_COMPRESS_OLD_MONTHS=true
# MEMTIER_BATCH_SIZE=50
# MEMTIER_TIMEOUT_SECONDS=120
# MEMTIER_API_RELEASE=

# --- misc -------------------------------------------------------------------
# Default language of the status page and the report (en or de); readers can switch it
# MEMTIER_LANGUAGE=en
# MEMTIER_LOG_LEVEL=info
# Time zone of the log; the report always shows your browser's local time
# TZ=Europe/Vienna
